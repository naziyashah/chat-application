
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="form-container">
        <div class="form-card">
            <a href="/chats" class="back-link">← Back to chats</a>

            <p class="eyebrow">NEW CONVERSATION</p>
            <h1>Write a new chat</h1>
            <p class="form-subtitle">
                Start a conversation by filling in the details below.
            </p>

            <form action="/chats" method="POST" class="chat-form">
                <label for="from">Your name</label>
                <input
                    type="text"
                    id="from"
                    name="from"
                    placeholder="Enter your name"
                    required
                >

                <label for="to">Receiver</label>
                <input
                    type="text"
                    id="to"
                    name="to"
                    placeholder="Who are you sending this to?"
                    required
                >

                <label for="msg">Your message</label>
                <textarea
                    id="msg"
                    name="msg"
                    placeholder="Write your message here..."
                    rows="5"
                    required
                ></textarea>

                <button type="submit">Create Chat →</button>
            </form>
        </div>
    </main>
</body>
</html>
